<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>DesktopBuddySharedTextureBridge</AssemblyName>
    <RootNamespace>DesktopBuddySharedTextureBridge</RootNamespace>
  </PropertyGroup>

  <Target Name="GenerateBridgeVersionInfo" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)..\VERSION">
      <Output TaskParameter="Lines" PropertyName="DesktopBuddyBridgeVersion" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <DesktopBuddyBridgeVersion Condition="'$(DesktopBuddyBridgeVersion)' == ''">0.0.0</DesktopBuddyBridgeVersion>
      <BridgeVersionInfoContent>namespace DesktopBuddySharedTextureBridge { internal static class BridgeVersionInfo { internal const string Version = "$(DesktopBuddyBridgeVersion)"%3B } }</BridgeVersionInfoContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BridgeVersionInfo.g.cs" Overwrite="true" Lines="$(BridgeVersionInfoContent)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BridgeVersionInfo.g.cs" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ResonitePath>C:\Program Files (x86)\Steam\steamapps\common\Resonite</ResonitePath>
    <RendererManagedPath>$(MSBuildThisFileDirectory)..\lib\renderer</RendererManagedPath>
    <LibPath>$(MSBuildThisFileDirectory)..\lib</LibPath>
    <ResoniteRendererManagedPath>$(ResonitePath)\Renderer\Renderite.Renderer_Data\Managed</ResoniteRendererManagedPath>
    <ThunderstoreRefsPath>$(MSBuildThisFileDirectory)..\obj\ThunderstoreRefs</ThunderstoreRefsPath>
    <InterprocessLibPackagePath>$(ThunderstoreRefsPath)\Nytra-InterprocessLib-3.0.0</InterprocessLibPackagePath>
    <BepInExRendererPackagePath>$(ThunderstoreRefsPath)\ResoniteModding-BepInExRenderer-5.4.233001</BepInExRendererPackagePath>
  </PropertyGroup>

  <!-- BepInEx 5.x + Harmony (reference-only) -->
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <Reference Include="BepInEx">
      <HintPath>$(BepInExRendererPackagePath)\BepInExPack\Renderer\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InterprocessLib.Unity">
      <HintPath>$(InterprocessLibPackagePath)\Renderer\BepInEx\plugins\InterprocessLib.BepInEx\InterprocessLib.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InterprocessLib.BepInEx_Extensions">
      <HintPath>$(InterprocessLibPackagePath)\Renderer\BepInEx\plugins\InterprocessLib.BepInEx\InterprocessLib.BepInEx_Extensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RestoreThunderstoreRefs" BeforeTargets="ResolveAssemblyReferences">
    <MakeDir Directories="$(ThunderstoreRefsPath)" />
    <DownloadFile
      SourceUrl="https://thunderstore.io/package/download/Nytra/InterprocessLib/3.0.0/"
      DestinationFolder="$(ThunderstoreRefsPath)"
      DestinationFileName="Nytra-InterprocessLib-3.0.0.zip"
      Condition="!Exists('$(InterprocessLibPackagePath)\Renderer\BepInEx\plugins\InterprocessLib.BepInEx\InterprocessLib.Unity.dll')" />
    <Unzip
      SourceFiles="$(ThunderstoreRefsPath)\Nytra-InterprocessLib-3.0.0.zip"
      DestinationFolder="$(InterprocessLibPackagePath)"
      OverwriteReadOnlyFiles="true"
      Condition="!Exists('$(InterprocessLibPackagePath)\Renderer\BepInEx\plugins\InterprocessLib.BepInEx\InterprocessLib.Unity.dll')" />
    <DownloadFile
      SourceUrl="https://thunderstore.io/package/download/ResoniteModding/BepInExRenderer/5.4.233001/"
      DestinationFolder="$(ThunderstoreRefsPath)"
      DestinationFileName="ResoniteModding-BepInExRenderer-5.4.233001.zip"
      Condition="!Exists('$(BepInExRendererPackagePath)\BepInExPack\Renderer\BepInEx\core\BepInEx.dll')" />
    <Unzip
      SourceFiles="$(ThunderstoreRefsPath)\ResoniteModding-BepInExRenderer-5.4.233001.zip"
      DestinationFolder="$(BepInExRendererPackagePath)"
      OverwriteReadOnlyFiles="true"
      Condition="!Exists('$(BepInExRendererPackagePath)\BepInExPack\Renderer\BepInEx\core\BepInEx.dll')" />
  </Target>

  <!-- Unity + Renderite DLLs (reference-only, not redistributed) -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(RendererManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RendererManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Renderite.Unity">
      <HintPath>$(RendererManagedPath)\Renderite.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Renderite.Shared">
      <HintPath>$(RendererManagedPath)\Renderite.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RendererManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Refresh repo-local reference DLLs from an installed Resonite before resolving references. -->
  <Target Name="RefreshRendererLibFromResonite" BeforeTargets="ResolveAssemblyReferences" Condition="Exists('$(ResonitePath)')">
    <ItemGroup>
      <RendererReferenceLibs Include="$(ResoniteRendererManagedPath)\UnityEngine.dll" />
      <RendererReferenceLibs Include="$(ResoniteRendererManagedPath)\UnityEngine.CoreModule.dll" />
      <RendererReferenceLibs Include="$(ResoniteRendererManagedPath)\Renderite.Unity.dll" />
      <RendererReferenceLibs Include="$(ResoniteRendererManagedPath)\Renderite.Shared.dll" />
      <RendererReferenceLibs Include="$(ResoniteRendererManagedPath)\Assembly-CSharp.dll" />
      <MissingRendererReferenceLibs Include="@(RendererReferenceLibs)" Condition="!Exists('%(RendererReferenceLibs.Identity)')" />
    </ItemGroup>
    <Error Condition="'@(MissingRendererReferenceLibs)' != ''" Text="[lib] Missing renderer reference DLL(s): @(MissingRendererReferenceLibs)" />
    <MakeDir Directories="$(LibPath)" />
    <MakeDir Directories="$(RendererManagedPath)" />
    <Copy SourceFiles="@(RendererReferenceLibs)" DestinationFolder="$(RendererManagedPath)" SkipUnchangedFiles="true" />
    <Message Text="[lib] Refreshed renderer reference DLLs from $(ResonitePath)" Importance="high" />
  </Target>

  <!-- Shared protocol file (single source of truth for both game-side and renderer) -->
  <ItemGroup>
    <Compile Include="..\Shared\SharedTextureBridgeProtocol.cs" />
  </ItemGroup>

  <!-- Deploy to local Resonite Renderer BepInEx plugins folder -->
  <Target Name="CopyToRenderer" AfterTargets="Build" Condition="Exists('$(ResonitePath)\Renderer\BepInEx\plugins') and '$(DesktopBuddySkipDeploy)' != 'true'">
    <MakeDir Directories="$(ResonitePath)\Renderer\BepInEx\plugins\DesktopBuddySharedTextureBridge" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ResonitePath)\Renderer\BepInEx\plugins\DesktopBuddySharedTextureBridge" Retries="0" />
  </Target>

</Project>
