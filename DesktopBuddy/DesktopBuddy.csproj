<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Embed git SHA as a compiled const for release diagnostics. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMsBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitSha" />
    </Exec>
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)..\VERSION">
      <Output TaskParameter="Lines" PropertyName="DesktopBuddyVersion" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <GitSha Condition="'$(GitSha)' == ''">unknown</GitSha>
      <DesktopBuddyVersion Condition="'$(DesktopBuddyVersion)' == ''">0.0.0</DesktopBuddyVersion>
      <BuildInfoContent>namespace DesktopBuddy { internal static class BuildInfo { internal const string GitSha = "$(GitSha)"%3B } internal static class DesktopBuddyVersionInfo { internal const string Version = "$(DesktopBuddyVersion)"%3B } }</BuildInfoContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Overwrite="true" Lines="$(BuildInfoContent)" />
    <WriteLinesToFile File="$(OutputPath)DesktopBuddy.sha" Overwrite="true" Lines="$(GitSha)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ResonitePath>C:\Program Files (x86)\Steam\steamapps\common\Resonite</ResonitePath>
    <LibPath>$(MSBuildThisFileDirectory)..\lib</LibPath>
    <ResoniteLibrariesPath>$(ResonitePath)\Libraries</ResoniteLibrariesPath>
    <ThunderstoreRefsPath>$(MSBuildThisFileDirectory)..\obj\ThunderstoreRefs</ThunderstoreRefsPath>
    <InterprocessLibPackagePath>$(ThunderstoreRefsPath)\Nytra-InterprocessLib-3.0.0</InterprocessLibPackagePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AutoPlugin" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="BepInEx.ResonitePluginInfoProps" Version="3.0.0" PrivateAssets="all" />
    <PackageReference Include="ResoniteModding.BepisResoniteWrapper" Version="1.0.2" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.0.0.1" />
  </ItemGroup>

  <!-- Game DLLs are refreshed from the local Resonite install as a single source of truth. -->
  <ItemGroup>
    <ResoniteGameReference Include="FrooxEngine">
      <SourcePath>$(ResonitePath)\FrooxEngine.dll</SourcePath>
      <HintPath>$(LibPath)\FrooxEngine.dll</HintPath>
    </ResoniteGameReference>
    <ResoniteGameReference Include="Elements.Core">
      <SourcePath>$(ResonitePath)\Elements.Core.dll</SourcePath>
      <HintPath>$(LibPath)\Elements.Core.dll</HintPath>
    </ResoniteGameReference>
    <ResoniteGameReference Include="Elements.Assets">
      <SourcePath>$(ResonitePath)\Elements.Assets.dll</SourcePath>
      <HintPath>$(LibPath)\Elements.Assets.dll</HintPath>
    </ResoniteGameReference>
    <ResoniteGameReference Include="SkyFrost.Base">
      <SourcePath>$(ResonitePath)\SkyFrost.Base.dll</SourcePath>
      <HintPath>$(LibPath)\SkyFrost.Base.dll</HintPath>
    </ResoniteGameReference>
    <ResoniteGameReference Include="SkyFrost.Base.Models">
      <SourcePath>$(ResonitePath)\SkyFrost.Base.Models.dll</SourcePath>
      <HintPath>$(LibPath)\SkyFrost.Base.Models.dll</HintPath>
    </ResoniteGameReference>
    <ResoniteGameReference Include="Renderite.Shared">
      <SourcePath>$(ResonitePath)\Renderite.Shared.dll</SourcePath>
      <HintPath>$(LibPath)\Renderite.Shared.dll</HintPath>
    </ResoniteGameReference>
    <ResoniteGameReference Include="Awwdio">
      <SourcePath>$(ResonitePath)\Awwdio.dll</SourcePath>
      <HintPath>$(LibPath)\Awwdio.dll</HintPath>
    </ResoniteGameReference>
    <ResoniteGameReference Include="BepuPhysics">
      <SourcePath>$(ResonitePath)\BepuPhysics.dll</SourcePath>
      <HintPath>$(LibPath)\BepuPhysics.dll</HintPath>
    </ResoniteGameReference>
    <ResoniteGameReference Include="FrooxEngine.Store">
      <SourcePath>$(ResonitePath)\FrooxEngine.Store.dll</SourcePath>
      <HintPath>$(LibPath)\FrooxEngine.Store.dll</HintPath>
    </ResoniteGameReference>
    <Reference Include="FrooxEngine">
      <HintPath>$(LibPath)\FrooxEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Elements.Core">
      <HintPath>$(LibPath)\Elements.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Elements.Assets">
      <HintPath>$(LibPath)\Elements.Assets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SkyFrost.Base">
      <HintPath>$(LibPath)\SkyFrost.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SkyFrost.Base.Models">
      <HintPath>$(LibPath)\SkyFrost.Base.Models.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Renderite.Shared">
      <HintPath>$(LibPath)\Renderite.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Awwdio">
      <HintPath>$(LibPath)\Awwdio.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepuPhysics">
      <HintPath>$(LibPath)\BepuPhysics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FrooxEngine.Store">
      <HintPath>$(LibPath)\FrooxEngine.Store.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InterprocessLib.FrooxEngine">
      <HintPath>$(InterprocessLibPackagePath)\plugins\InterprocessLib.BepisLoader\InterprocessLib.FrooxEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InterprocessLib.BepisLoader_Extensions">
      <HintPath>$(InterprocessLibPackagePath)\plugins\InterprocessLib.BepisLoader\InterprocessLib.BepisLoader_Extensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RestoreThunderstoreRefs" BeforeTargets="ResolveAssemblyReferences">
    <MakeDir Directories="$(ThunderstoreRefsPath)" />
    <DownloadFile
      SourceUrl="https://thunderstore.io/package/download/Nytra/InterprocessLib/3.0.0/"
      DestinationFolder="$(ThunderstoreRefsPath)"
      DestinationFileName="Nytra-InterprocessLib-3.0.0.zip"
      Condition="!Exists('$(InterprocessLibPackagePath)\plugins\InterprocessLib.BepisLoader\InterprocessLib.FrooxEngine.dll')" />
    <Unzip
      SourceFiles="$(ThunderstoreRefsPath)\Nytra-InterprocessLib-3.0.0.zip"
      DestinationFolder="$(InterprocessLibPackagePath)"
      OverwriteReadOnlyFiles="true"
      Condition="!Exists('$(InterprocessLibPackagePath)\plugins\InterprocessLib.BepisLoader\InterprocessLib.FrooxEngine.dll')" />
  </Target>

  <!-- Refresh repo-local reference DLLs from an installed Resonite before resolving references. -->
  <Target Name="RefreshLibFromResonite" BeforeTargets="ResolveAssemblyReferences" Condition="Exists('$(ResonitePath)')">
    <ItemGroup>
      <MissingResoniteGameReference Include="@(ResoniteGameReference)" Condition="!Exists('%(ResoniteGameReference.SourcePath)')" />
    </ItemGroup>
    <Error Condition="'@(MissingResoniteGameReference)' != ''" Text="[lib] Missing game reference DLL(s) in $(ResonitePath): @(MissingResoniteGameReference->'%(SourcePath)', ', ')" />
    <MakeDir Directories="$(LibPath)" />
    <Copy SourceFiles="@(ResoniteGameReference->'%(SourcePath)')" DestinationFiles="@(ResoniteGameReference->'%(HintPath)')" SkipUnchangedFiles="true" />
    <Message Text="[lib] Refreshed game reference DLLs from $(ResonitePath): @(ResoniteGameReference)" Importance="high" />
  </Target>

  <!-- Shared protocol file (single source of truth for both game-side and renderer) -->
  <ItemGroup>
    <Compile Include="..\Shared\SharedTextureBridgeProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\icon_transparent.png" Link="icon_transparent.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\plus.png" Link="plus.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\scripts\CollectDesktopBuddyDiagnostics.ps1" Link="CollectDesktopBuddyDiagnostics.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <DesktopBuddyManagedDependencyName Include="FFmpeg.AutoGen.dll" />
    <DesktopBuddyManagedDependencyName Include="Microsoft.Windows.SDK.NET.dll" />
    <DesktopBuddyManagedDependencyName Include="WinRT.Runtime.dll" />
  </ItemGroup>

  <!-- Deploy to local Resonite BepisLoader plugin layout (skipped on CI / when Resonite not installed) -->
  <Target Name="CopyToResonite" AfterTargets="Build" Condition="Exists('$(ResonitePath)') and '$(DesktopBuddySkipDeploy)' != 'true'">
    <ItemGroup>
      <DesktopBuddyRuntime Include="$(MSBuildThisFileDirectory)..\DesktopBuddyRuntime\**\*" />
      <DesktopBuddyManagedDependency Include="@(DesktopBuddyManagedDependencyName->'$(OutputPath)%(Identity)')" />
    </ItemGroup>
    <MakeDir Directories="$(ResonitePath)\BepInEx\plugins\DevL0rd-DesktopBuddy\DesktopBuddy;$(ResonitePath)\BepInEx\plugins\DevL0rd-DesktopBuddyRuntime\DesktopBuddy\DesktopBuddyRuntime" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ResonitePath)\BepInEx\plugins\DevL0rd-DesktopBuddy\DesktopBuddy" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" />
    <Copy SourceFiles="$(OutputPath)DesktopBuddy.sha" DestinationFolder="$(ResonitePath)\BepInEx\plugins\DevL0rd-DesktopBuddy\DesktopBuddy" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" />
    <Copy SourceFiles="$(OutputPath)icon_transparent.png" DestinationFolder="$(ResonitePath)\BepInEx\plugins\DevL0rd-DesktopBuddy\DesktopBuddy" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" />
    <Copy SourceFiles="$(OutputPath)plus.png" DestinationFolder="$(ResonitePath)\BepInEx\plugins\DevL0rd-DesktopBuddy\DesktopBuddy" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" />
    <Copy SourceFiles="$(OutputPath)CollectDesktopBuddyDiagnostics.ps1" DestinationFolder="$(ResonitePath)\BepInEx\plugins\DevL0rd-DesktopBuddy\DesktopBuddy" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" />
    <Copy SourceFiles="@(DesktopBuddyRuntime)" DestinationFiles="@(DesktopBuddyRuntime->'$(ResonitePath)\BepInEx\plugins\DevL0rd-DesktopBuddyRuntime\DesktopBuddy\DesktopBuddyRuntime\%(RecursiveDir)%(Filename)%(Extension)')" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" />
    <Copy SourceFiles="@(DesktopBuddyManagedDependency)" DestinationFolder="$(ResonitePath)\BepInEx\plugins\DevL0rd-DesktopBuddyRuntime\DesktopBuddy\DesktopBuddyRuntime" ContinueOnError="true" Retries="0" RetryDelayMilliseconds="0" />
  </Target>

</Project>
